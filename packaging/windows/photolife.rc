#include <winver.h>

IDI_ICON1 ICON "photolife.ico"

#ifndef PHOTOLIFE_VERSION_RC
#define PHOTOLIFE_VERSION_RC 0,1,0,0
#endif
#ifndef PHOTOLIFE_VERSION_STR
#define PHOTOLIFE_VERSION_STR "0.1.0"
#endif

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    PHOTOLIFE_VERSION_RC
    PRODUCTVERSION PHOTOLIFE_VERSION_RC
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0x0L
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PhotoLife"
            VALUE "FileDescription",  "PhotoLife nature photo catalogue"
            VALUE "FileVersion",      PHOTOLIFE_VERSION_STR
            VALUE "InternalName",     "PhotoLife"
            VALUE "OriginalFilename", "PhotoLife.exe"
            VALUE "ProductName",      "PhotoLife"
            VALUE "ProductVersion",   PHOTOLIFE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
